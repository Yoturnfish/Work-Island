"ToggleWebsiteRules"><Grid Margin="6,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/></Grid.ColumnDefinitions><TextBlock Text="网站" VerticalAlignment="Center"/><Path x:Name="WebsiteDisclosure" Grid.Column="1" Data="M 1,1 L 4,4 L 7,1" Width="8" Height="5" Stroke="#ADFFFFFF" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" RenderTransformOrigin=".5,.5" IsHitTestVisible="False"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path></Grid></Button><Button Grid.Column="4" Content="＋" Foreground="#40FF61" FontSize="17" Click="ChooseWebsite" x:Name="AddWebsiteSelectionButton" AutomationProperties.Name="选择并添加当前网页"/></Grid>
        <Grid x:Name="RuleInputRow" Height="30" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox x:Name="RuleInput" AutomationProperties.Name="工作进程名" KeyDown="RuleInputKey"/><Button x:Name="AddRuleButton" Grid.Column="1" Content="＋" Click="AddRule" FontSize="18"/></Grid>
        <TextBlock x:Name="RecognitionStatus" Visibility="Collapsed" FontSize="11" Foreground="#FFB755" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <Grid x:Name="WebsiteInputRow" Height="30" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox x:Name="WebsiteInput" AutomationProperties.Name="网站域名或关键词" KeyDown="RuleInputKey"/><Button Grid.Column="1" Content="＋" Click="AddWebsite" FontSize="18"/></Grid>
        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel x:Name="RuleRows" Visibility="Collapsed"/><StackPanel x:Name="WebsiteRows" Grid.Column="2" Visibility="Collapsed"/></Grid>
       </StackPanel>
       <StackPanel x:Name="HistoryPage" Visibility="Collapsed"><TextBlock x:Name="HistoryLabel" Visibility="Collapsed"/><StackPanel x:Name="HistoryRows"/></StackPanel>
      </Grid>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Border>
